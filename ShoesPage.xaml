<Page x:Class="BayazitovObuv.ShoesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BayazitovObuv"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Список обуви" FontFamily="Calibri">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" 
    Orientation="Vertical" Margin="10" Grid.ColumnSpan="2">
            <TextBlock Text="Вы авторизованы как:" FontSize="14" HorizontalAlignment="Left"/>
            <TextBlock Name="FIOTB" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left"/>
            <TextBlock Text="Роль:" FontSize="14" HorizontalAlignment="Left"/>
            <TextBlock Name="RoleTB" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left"/>
        </StackPanel>

        <TextBlock Name="TBlockCount" Grid.Row="1" Grid.Column="0" 
           FontSize="20" Margin="5"
           HorizontalAlignment="Left"
           VerticalAlignment="Top"></TextBlock>

        <StackPanel Grid.Column="1" Grid.Row="1" Margin="5"
            Orientation="Vertical" HorizontalAlignment="Left">
            <TextBlock Text="поиск по наименованию" TextAlignment="Center"
        Width="250" FontSize="20"></TextBlock>

            <TextBox Name="TBoxSearch"  Width="250" FontSize="15" TextChanged="TBoxSearch_TextChanged"></TextBox>
        </StackPanel>

        <StackPanel Grid.Column="2" Grid.Row="1" Margin="5"
            Orientation="Vertical" HorizontalAlignment="Center">
            <RadioButton Name="RButtonUp"  Content="по возрастанию стоимости" GroupName="Sort"
        Width="300" FontSize="20" Checked="RButtonUp_Checked" ></RadioButton>

            <RadioButton Name="RButtonDown" Content="по убыванию стоимости" GroupName="Sort"
        Width="300" FontSize="20" Checked="RButtonDown_Checked" ></RadioButton>
        </StackPanel>

        <StackPanel Grid.Column="3" Grid.Row="1" Margin="5"
            Orientation="Vertical" HorizontalAlignment="Left">
            <TextBlock Text="фильтрация" TextAlignment="Center" Width="300" FontSize="20"></TextBlock>

            <ComboBox Name="ComboType"   FontSize="15" Width="200" SelectionChanged="ComboType_SelectionChanged">
                <TextBlock>Все виды</TextBlock>
                <TextBlock>Детская обувь</TextBlock>
                <TextBlock>Женская обувь</TextBlock>
                <TextBlock>Мужская обувь</TextBlock>
            </ComboBox>
        </StackPanel>
        <ListView Name="ProductListView" Grid.Row="2" Grid.ColumnSpan="4">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Добавить к заказу" Click="AddToOrderMenuItem_Click"/>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="800"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Image Width="220" Grid.RowSpan="4" Grid.Column="0" Stretch="UniformToFill" HorizontalAlignment="Center">
                            <Image.Source>
                                <Binding Path="ProductPhotoPath">
                                    <Binding.TargetNullValue>
                                        <ImageSource>
                                            /Res/picture.png
                                        </ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>

                        <TextBlock Text="{Binding ProductName}" FontWeight="Bold" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left"
                    FontSize="20" TextWrapping="Wrap"></TextBlock>

                        <TextBlock Text="{Binding ProductDescription}" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left"
                    FontSize="20" TextWrapping="Wrap"></TextBlock>


                        <TextBlock Text="{Binding ProductCost, StringFormat={}{0:0} рублей}" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Left"
                    FontSize="20"></TextBlock>
                        


                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Name="ViewOrderBtn" Content="Просмотреть заказ" Grid.Row="2" Grid.ColumnSpan="4" Click="ViewOrderBtn_Click"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" FontSize="15" Margin="10"/>
    </Grid>
</Page>
