<Page x:Class="BayazitovObuv.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BayazitovObuv"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage" FontFamily="Calibri">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Логин" 
       HorizontalAlignment="Right" VerticalAlignment="Bottom" 
       Margin="5" FontSize="14"/>
        <TextBox Grid.Row="0" Grid.Column="1" Name="LoginTB"
     HorizontalAlignment="Stretch" VerticalAlignment="Bottom" 
     Margin="5" FontSize="14"/>
        <Button Grid.Row="2" Grid.Column="0" Content="Войти как гость"
    HorizontalAlignment="Left" VerticalAlignment="Center" 
    Margin="5" FontSize="14" Click="Button_Click" />
        <Button Name="LoginBtn" Grid.Row="2" Grid.Column="1" Content="Войти" 
    HorizontalAlignment="Right" VerticalAlignment="Center" 
    Margin="5" FontSize="14" Click="LoginBtn_Click"/>
    </Grid>
</Page>
